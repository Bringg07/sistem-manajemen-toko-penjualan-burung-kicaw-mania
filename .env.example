# Salin file ini menjadi .env.local lalu isi nilainya dari dashboard Supabase
# (Project Settings -> API). JANGAN commit .env.local ke git.

# Wajib — dipakai client browser & server (aman diekspos ke publik)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Opsional tapi disarankan untuk operasi admin di server (JANGAN pernah diekspos ke client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opsional — domain publik situs untuk metadata SEO (fallback: https://kicaw-mania.example.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
